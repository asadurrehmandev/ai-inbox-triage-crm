# Leave these blank to run the whole demo on the built-in rule engine.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5

# Worker. The scheduler polls the mailbox on this interval.
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=60

# Optional production sinks. Without them, leads stay in the mock CRM and
# Slack alerts stay in the dashboard feed.
HUBSPOT_TOKEN=
GHL_API_KEY=
GHL_LOCATION_ID=
SLACK_WEBHOOK_URL=

# Optional real mailbox. Without these, Lane reads the sample feed.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

DATABASE_PATH=./data/triage.db
