# Copy to .env before starting. The API refuses mutations when API_TOKEN is empty.
# These sample values work only while DEMO_MODE=true. DEMO_MODE=false refuses them.
# Docker Compose binds to 127.0.0.1 and defaults DEMO_MODE to false, so a
# published stack needs its own API_TOKEN, WEBHOOK_SECRET, and DASHBOARD_PASSWORD.
API_TOKEN=lane-demo-token
WEBHOOK_SECRET=lane-demo-webhook
DASHBOARD_PASSWORD=lane-demo
DEMO_MODE=true
CORS_ORIGINS=http://127.0.0.1:8742,http://localhost:8742

# Leave the model keys blank to run the demo on the rule engine.
# ANTHROPIC_MODEL was checked on 2026-10-22: claude-sonnet-5-5 is Active.
# claude-sonnet-4-5-20250929 is deprecated.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5-5

# Worker. The scheduler polls the mailbox on this interval.
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=60

# Optional production sinks. Without them, leads stay in the mock CRM and
# Slack alerts stay in the dashboard feed.
HUBSPOT_TOKEN=
GHL_API_KEY=
GHL_LOCATION_ID=
SLACK_WEBHOOK_URL=

# Authserv-id of the server that receives the mail (the provider's Authentication-Results).
# Exact match, case-insensitive. Comma-separated if more than one. Empty means every
# sender is unauthenticated: a header the sender posts is ignored.
TRUSTED_AUTHSERV_ID=

# Optional real mailbox. Without these, Lane reads the sample feed.
# Reset is refused while IMAP_HOST is set, so a demo reset cannot orphan Seen mail.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

DATABASE_PATH=./data/triage.db
